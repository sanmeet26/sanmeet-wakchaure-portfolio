# Intentionally committed as a reference for developers.
# Never add real credentials or secrets to this file.

# Resend API key, used only by the /api/contact serverless function.
# Never expose this with a VITE_ prefix — that would ship it to the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=your-email@example.com

# Sender address configured and verified in Resend
CONTACT_FROM_EMAIL=portfolio@your-verified-domain.com
